{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=VocabularyBuilder.Prod.db"
  },
  "DatabaseMode": "Production",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OpenAI": {
    "ApiKey": "your_key_here"
  },
  "Anki": {
    "DeckNameFormat": "{0}::Vocabulary",
    "DeckNames": {
      "English": "English::Vocabulary",
      "French": "French::Vocabulary"
    }
  },
  "WordReference": {
    "MaxTranslations": 5,
    "IncludeConjugations": true,
    "RequestDelayMilliseconds": 1000
  },
  "AllowedHosts": "*",
  "Study": {
    "NewCardsPerDay": 12,
    "MaxCardsPerSession": 60,
    "NewCardsPerBatch": 4,
    "InterleaveWindowMinutes": 2,
    "LearnAheadMinutes": 20,
    "DayRolloverHourUtc": 4,
    "LearningStepsMinutes": [
      1,
      3,
      5,
      8
    ],
    "LearningExitSuccesses": 2,
    "RelearningExitSuccesses": 1,
    "LearningExitSpacingMinutes": 4,
    "MaxLearningRetrievals": 10,
    "GraduatingIntervalDays": 1,
    "EasyIntervalDays": 4,
    "MinEaseFactor": 1.3,
    "EasyBonus": 1.3,
    "HardIntervalMultiplier": 1.2,
    "LapseIntervalPercent": 0,
    "IntervalFuzzPercent": 5,
    "MaxIntervalDays": 365,
    "MatureIntervalDays": 21,
    "LongGapDays": 7,
    "OverdueRatio": 1.5,
    "LongGapEscalationMinRung": 3,
    "LongGapProbeType": "MeaningToWordRecall",
    "SuccessEmaAlpha": 0.3,
    "FailureRungDrop": 1,
    "FastAnswerMs": 3000,
    "SlowAnswerMs": 10000,
    "SlowAnswerMsPerLetter": 1500,
    "DifficultyTiers": {
      "ComfortableMinEase": 2.3,
      "ComfortableMinSuccess": 0.85,
      "DifficultMaxEase": 1.8,
      "DifficultMinLapses": 2,
      "DifficultMaxSuccess": 0.7
    },
    "FollowUpsByTier": {
      "Comfortable": 0,
      "Shaky": 1,
      "Difficult": 2
    },
    "EnrichmentStaleClaimMinutes": 5,
    "EnrichmentMaxAttempts": 3,
    "DistractorPoolSize": 500,
    "ChoiceOptionCount": 4,
    "ScrambleDecoyLetters": 0,
    "Ladder": [
      {
        "Name": "Introduction",
        "PromoteAfter": 1,
        "Exercises": [
          {
            "Type": "WordToMeaningReveal"
          }
        ]
      },
      {
        "Name": "Recognition",
        "PromoteAfter": 3,
        "Exercises": [
          {
            "Type": "MeaningToWordChoice"
          },
          {
            "Type": "ContextToWordChoice"
          },
          {
            "Type": "WordToCollocatesChoice",
            "Tolerant": true
          },
          {
            "Type": "WordToMeaningChoice"
          }
        ]
      },
      {
        "Name": "Scaffolded",
        "PromoteAfter": 3,
        "Exercises": [
          {
            "Type": "MeaningToWordSyllableScramble"
          },
          {
            "Type": "MeaningToWordScramble"
          },
          {
            "Type": "TranslationToSentenceScramble",
            "Tolerant": true
          },
          {
            "Type": "MeaningToWordCuedType"
          }
        ]
      },
      {
        "Name": "Production",
        "PromoteAfter": 0,
        "Exercises": [
          {
            "Type": "ContextToWordRecall"
          },
          {
            "Type": "MeaningToWordRecall"
          }
        ]
      }
    ]
  }
}
